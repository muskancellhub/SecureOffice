# --- Logs (docs/LOGGING_PLAN.md) — dev sink + archives, never commit ---
# Both forms needed: logs/ matches the dev directory; /logs matches the
# prod symlink to /var/log/secureoffice/archive (trailing-slash patterns
# do not match symlinks).
logs/
/logs

# --- Secrets & environment (never commit real values) ---
.env
.env.*
!**/.env.example
!**/.env.*.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv311/
venv/
env/
.envrc
*.egg-info/
.eggs/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
coverage/

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.vite/

# TypeScript incremental
*.tsbuildinfo

# --- Build outputs ---
dist/

# --- OS & editors ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/

# --- Keys & credentials ---
*.pem
*.p12
*.key
id_rsa
id_rsa.pub
*.keystore

# --- Local databases (if used) ---
*.db
*.sqlite
*.sqlite3

# --- Agent / IDE local config ---
**/.claude/settings.local.json
.gstack/

# --- Playwright E2E test artifacts ---
# Auth state files contain session tokens - never commit
frontend/e2e/.auth/*.json
frontend/e2e/test-results/
frontend/e2e/playwright-report/
frontend/e2e/.cache/

# OLD/DUPLICATE folders - all artifacts now in frontend/e2e/ only
frontend/playwright-report/
frontend/test-results/

# Database dumps — sensitive (contain password hashes). Never commit.
*_dump.sql
*.dump
