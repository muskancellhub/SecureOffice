APP_NAME=SecureOffice2 API
APP_ENV=development
APP_DEBUG=false
BACKEND_CORS_ORIGINS=http://localhost:5173

DATABASE_URL=

JWT_SECRET_KEY=replace_with_long_random_secret
OAUTH_SESSION_SECRET=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

OTP_EXPIRE_MINUTES=5
# Ops mailbox notified when a network design is submitted (BUG-EMAIL-001).
# Leave blank to mock the email to the console; set it to enable real handoff.
DESIGN_HANDOFF_EMAIL=ops@cellhubms.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=SecureOffice2
DEFAULT_TENANT_ID=45c555c6-c002-4427-9149-3db675749360
BOOTSTRAP_SUPER_ADMIN_EMAIL=muskan.d@cellhubms.com

# Multi-tenant Phase 4: Postgres Row-Level Security hardening. OFF by default.
# When true, runtime migrations ENABLE+FORCE RLS + a tenant-isolation policy on
# every tenant-scoped table, and each request sets app.current_tenant_id.
# Flipping it back to false reverts (drops policies + disables RLS) — kill switch.
# Requires the app DB role to be a NON-superuser owner (superusers bypass RLS).
ENABLE_RLS=false

FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

CDW_INGEST_MODE=openai
CDW_AGENT_COMMAND=
CDW_AGENT_TIMEOUT_SECONDS=60
CDW_OPENAI_MODEL=gpt-4.1-mini

ZABBIX_URL=
ZABBIX_USERNAME=
ZABBIX_PASSWORD=

# Comma-separated additional super-admin emails (allowlist; source of truth in env, not DB).
# They activate via the secure /auth/super-admin/password-setup flow.
SUPER_ADMIN_EMAILS=
# Minutes a super-admin password-setup link is valid (single-use).
SUPER_ADMIN_SETUP_TTL_MINUTES=60
