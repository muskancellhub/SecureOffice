{
  "name": "secureoffice2-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:webkit": "playwright test --project=webkit",
    "e2e:all-phases": "playwright test e2e/tests/intake e2e/tests/designs/design-builder-simple.spec.ts e2e/tests/designs/design-history.spec.ts e2e/tests/cart-and-orders e2e/tests/quotes e2e/tests/onboarding e2e/tests/tenant-isolation e2e/tests/admin --project=chromium --workers=1",
    "e2e:critical": "playwright test e2e/tests/auth e2e/tests/intake e2e/tests/designs --project=chromium --workers=1",
    "e2e:phase1": "playwright test e2e/tests/intake e2e/tests/designs/design-builder-simple.spec.ts --project=chromium --workers=1",
    "e2e:phase1a": "playwright test e2e/tests/intake --project=chromium --workers=1",
    "e2e:phase1b": "playwright test e2e/tests/designs/design-builder-simple.spec.ts --project=chromium --workers=1",
    "e2e:phase2": "playwright test e2e/tests/cart-and-orders e2e/tests/catalog --project=chromium --workers=1",
    "e2e:phase3": "playwright test e2e/tests/quotes --project=chromium --workers=1"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.183.1",
    "axios": "^1.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.24",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vite": "^5.4.20",
    "vitest": "^4.1.0"
  }
}
