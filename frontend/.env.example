# ── Origins ───────────────────────────────────────────────────────────────────
# Both of these are baked into the JS bundle at build time, so an absolute
# hostname here makes the build machine-specific. Leave them UNSET in any
# environment fronted by a reverse proxy: the app then falls back to the
# relative paths /api and /grafana (see src/api/config.ts), and the same bundle
# runs on localhost, on the deploy box, and behind a domain.
#
# Leave unset — vite.config.ts proxies /api to localhost:8000 in dev. Set an
# absolute origin only to bypass the proxy against a remote backend.
# VITE_API_BASE_URL=http://localhost:8000
# Grafana embeds. Unset ⇒ the Grafana tab is hidden entirely (monitoring is a
# separate docker-compose stack; see monitoring/README).
VITE_GRAFANA_URL=http://localhost:3000

# ── Payments (Square — sole provider) ─────────────────────────────────────────
# Square (sandbox). App ID + Location ID are publishable (browser-safe). The
# access token is a backend-only secret and must NOT appear here.
# Script CDN: https://sandbox.web.squarecdn.com/v1/square.js (prod drops "sandbox.").
VITE_SQUARE_ENV=sandbox
VITE_SQUARE_APP_ID=sandbox-sq0idb-your_app_id
VITE_SQUARE_LOCATION_ID=your_location_id
